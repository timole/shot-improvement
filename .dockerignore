# spec 095: az acr build has no .gitignore fallback (unlike gcloud's
# .gcloudignore) - without this, every build uploads the full working
# tree (venv/ alone is ~500MB) as build context. server/Dockerfile only
# needs server/ and web/; everything else here is the laptop app.

venv/
server/.venv/
server/tests/
recordings/
pending/
models/
logs/
__pycache__/
*.pyc
.pytest_cache/
.git/
.gitignore
specs/
tests/
tools/
core/
gui.py
record.py
requirements.txt
README.md
cloud_sync_tombstones.json
# Spec 147: the Android app's own source + Gradle build output
# (android/app/ alone is tens of MB of APKs/intermediates) - the server
# image is Python-only and never needs any of it.
android/
